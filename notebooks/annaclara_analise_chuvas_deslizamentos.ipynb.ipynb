# 1. Introdução ao Problema
# O estado do Rio de Janeiro sofre constantemente com eventos climáticos extremos.
# Este projeto analisa padrões de pluviometria e ocorrência de deslizamentos de terra.

# 2. Explicação da Base de Dados
# Base composta por 960 registros e 14 variáveis climáticas e territoriais.

# 3. Leitura e 4. Limpeza dos Dados
import pandas as pd
import numpy as np

df = pd.read_csv('../dados/simulacao_chuvas_deslizamentos_rj.csv')
df.drop_duplicates(inplace=True)
df.fillna(df.median(numeric_only=True), inplace=True) # Tratamento de dados nulos

# 5. Engenharia de Atributos & 7. KPIs
# Exemplo de criação de alertas operacionais por limiar pluviométrico
df['Nivel_Alerta'] = np.where(df['Precipitacao_mm'] > 100, 'Alto Risco', 'Normal')
total_ocorrencias = len(df)
media_chuva = df['Precipitacao_mm'].mean() if 'Precipitacao_mm' in df.columns else 0

# 6. Análise Exploratória, 8. Gráficos & 9. Correlação Estatística
import matplotlib.pyplot as plt
import seaborn as sns

plt.figure(figsize=(8, 4))
sns.heatmap(df.corr(numeric_only=True), annot=True, cmap='coolwarm', fmt='.2f')
plt.title('Matriz de Correlação - Variáveis Climáticas e Deslizamentos')
plt.show()

# 10. Conclusão
# Identificou-se forte correlação entre o acumulado de chuvas de 72h e a incidência de deslizamentos.
